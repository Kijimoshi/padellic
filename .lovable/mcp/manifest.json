{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pngtyjmqhhbeubtevcez.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "padellic",
      "version": "0.1.0",
      "title": "Padellic"
    },
    "tools": [
      {
        "name": "list_tournaments",
        "title": "List tournaments",
        "description": "List the signed-in organiser's padel tournaments, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_tournament",
        "title": "Get tournament",
        "description": "Get a tournament's players, matches and current standings.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "tournament_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Tournament id."
            }
          },
          "required": [
            "tournament_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "record_score",
        "title": "Record match score",
        "description": "Record the final score of a match; both scores must add up to the tournament's points per match.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "match_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Match id."
            },
            "score_a": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Points for team A."
            },
            "score_b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Points for team B."
            }
          },
          "required": [
            "match_id",
            "score_a",
            "score_b"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
